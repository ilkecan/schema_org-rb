module SchemaOrg
  module Mixins
    module <%= name %>
<% parents.each do |parent| -%>
      include <%= parent %>
<% end -%>
<% unless parents.empty? -%>

<% end -%>
      def self.schema_property_definitions
<% if properties.empty? -%>
        {}.freeze
<% else -%>
        {
<% properties.each do |property| -%>
          <%= property.name %>: {
            schema_name: <%= property.schema_name.inspect %>,
            schema_url: <%= property.schema_url.inspect %>,
            comment_lines: [<%= property.comment_lines.map(&:inspect).join(", ") %>].freeze,
            ranges: [<%= property.types.map { |type| type.to_s.inspect }.join(", ") %>].freeze,
            external_ranges: [<%= property.external_ranges.map(&:inspect).join(", ") %>].freeze,
            inverse_of: <%= property.inverse_of.inspect %>,
            superseded_by: <%= property.superseded_by.inspect %>,
            supersedes: <%= property.supersedes.inspect %>
          }.freeze<%= "," unless property == properties.last %>
<% end -%>
        }.freeze
<% end -%>
      end
<% unless properties.empty? -%>

<% end -%>
<% properties.each do |property| -%>
<% property.lines.each do |line| -%>
      #<%= " #{line}" unless line.empty? %>
<% end -%>
      def <%= property.name %>
        read_property(:<%= property.name %>)
      end

<% property.lines.each do |line| -%>
      #<%= " #{line}" unless line.empty? %>
<% end -%>
      def <%= property.name %>=(value)
        write_property(:<%= property.name %>, value)
      end
<% unless property == properties.last -%>

<% end -%>
<% end -%>
    end
  end
end
