module SchemaOrg
  module Mixins
    module <%= name %>
<% parents.each do -%>
      include <%= it %>
<% end -%>

      def self.schema_property_definitions
        {
<% properties.each do |property| -%>
          <%= property.name.inspect %> => {
            schema_name: <%= property.schema_name.inspect %>,
            ranges: <%= property.types.map(&:to_s).inspect %>,
          }.freeze,
<% end -%>
        }.freeze
      end

<% properties.each do |property| -%>
      def <%= property.name %>
        read_property(:<%= property.name %>)
      end

      def <%= property.name %>=(value)
        write_property(:<%= property.name %>, value)
      end

<% end -%>
    end
  end
end
